{
  "id": "root",
  "type": "row",
  "theme": {
    "light": "paper",
    "dark": "graphite"
  },
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 240
      },
      "min": 40,
      "max": 360,
      "children": [
        {
          "id": "spaces",
          "type": "block",
          "content": {
            "mod": "spaces"
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 36
          },
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "main",
          "type": "row",
          "gap": 6,
          "padding": [
            6,
            6
          ],
          "children": [
            {
              "id": "board",
              "type": "block",
              "radius": 6,
              "border": {
                "width": 1,
                "color": "border"
              },
              "content": {
                "mod": "shepherd",
                "props": {
                  "view": "board"
                }
              }
            },
            {
              "id": "detail",
              "type": "block",
              "hidden": true,
              "size": {
                "px": 620
              },
              "min": 380,
              "radius": 6,
              "border": {
                "width": 1,
                "color": "border"
              },
              "content": {
                "mod": "shepherd",
                "props": {
                  "panel": "detail"
                }
              }
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 24
          },
          "content": {
            "mod": "shepherd",
            "props": {
              "panel": "status"
            }
          }
        }
      ],
      "floating": [
        {
          "id": "bar",
          "content": {
            "mod": "shepherd",
            "props": {
              "panel": "bar"
            }
          },
          "edge": "bottom",
          "align": "center"
        }
      ]
    }
  ]
}
