{
  "id": "root",
  "type": "row",
  "toast": "shepherd",
  "theme": {
    "light": "paper",
    "dark": "graphite"
  },
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 240
      },
      "min": 40,
      "max": 360,
      "children": [
        {
          "id": "spaces",
          "type": "block",
          "content": {
            "mod": "shepherd",
            "props": {
              "panel": "spaces"
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 36
          },
          "content": {
            "mod": "shepherd",
            "props": {
              "panel": "tabs"
            }
          }
        },
        {
          "id": "area",
          "type": "column",
          "gap": 6,
          "padding": [
            6,
            6
          ],
          "children": [
            {
              "id": "main",
              "type": "row",
              "gap": 6,
              "children": [
                {
                  "id": "board",
                  "type": "block",
                  "radius": 6,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "content": {
                    "mod": "shepherd",
                    "props": {
                      "view": "board"
                    }
                  }
                },
                {
                  "id": "detail",
                  "type": "column",
                  "hidden": true,
                  "size": {
                    "px": 620
                  },
                  "min": 380,
                  "radius": 6,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "resizable": false,
                  "children": [
                    {
                      "id": "detailbody",
                      "type": "block",
                      "size": {
                        "weight": 1
                      },
                      "content": {
                        "mod": "shepherd",
                        "props": {
                          "panel": "detail"
                        }
                      }
                    },
                    {
                      "id": "taskterm",
                      "type": "block",
                      "hidden": true,
                      "size": {
                        "weight": 1
                      },
                      "border": {
                        "width": 0,
                        "color": "border"
                      },
                      "content": {
                        "agent": "focused"
                      }
                    }
                  ]
                }
              ],
              "size": {
                "weight": 7
              }
            },
            {
              "id": "bottom",
              "type": "stack",
              "active": "term",
              "size": {
                "weight": 3
              },
              "children": [
                {
                  "id": "term",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 6,
                      "radius": 6,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "lone": true
                    }
                  }
                },
                {
                  "id": "noshep",
                  "type": "block",
                  "content": {
                    "mod": "shepherd",
                    "props": {
                      "panel": "noshep"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 24
          },
          "content": {
            "mod": "shepherd",
            "props": {
              "panel": "status"
            }
          }
        }
      ]
    }
  ]
}
